<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Debug builds talk to the backend over plain HTTP (the emulator reaches the
         host at http://10.0.2.2:8080), which Android blocks by default from API 28
         on. This stays in the debug source set only: the release APK points at
         https://api.mytripsafar.com and must keep cleartext OFF, so a
         misconfigured base URL fails loudly instead of shipping the JWT in clear.
    -->
    <application android:usesCleartextTraffic="true"/>
</manifest>
