# TravelCRM mobile — build-time configuration.
#
# Flutter has no runtime .env; these are passed with --dart-define. This file
# documents what the app reads and what the values mean.
#
#   flutter run \
#     --dart-define=API_BASE_URL=http://10.0.2.2:8080 \
#     --dart-define=ENABLE_NETWORK_LOGS=true

# Backend root.
#   Android emulator -> http://10.0.2.2:8080   (alias for the host machine)
#   iOS simulator    -> http://localhost:8080
#   Physical device  -> http://<host-lan-ip>:8080
API_BASE_URL=http://10.0.2.2:8080

# Request/response logging to `adb logcat`, tagged [http]. Debug builds only —
# release ignores this regardless of the value.
ENABLE_NETWORK_LOGS=true

# No API key, client secret or service credential belongs here. The only
# credential the app ever holds is the signed-in user's own JWT, which the
# server issues at login and which lives in flutter_secure_storage.
